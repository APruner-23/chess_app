// Cloudflare Workers static assets (the Git integration runs `npx wrangler deploy`).
// SPA routing replaces public/_redirects; public/_headers still sets COOP/COEP.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chess-app",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application",
  },
}
