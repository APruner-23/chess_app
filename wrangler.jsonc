// Cloudflare Worker: static assets plus the sync API (worker/index.ts) on D1.
// SPA routing replaces public/_redirects; public/_headers still sets COOP/COEP.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "chess-app",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-06",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  // No database_id: wrangler creates the database on the first deploy.
  "d1_databases": [{ "binding": "DB", "database_name": "chess-app-sync" }],
}
